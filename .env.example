# Required — Gemini is Perception, Memory classification, and Decision-with-attachments
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Decision without attachments (tool picking) — local Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_OLLAMA_MODEL=nomic-embed-text

# Gateway V7 (professor ZIP) — chat + embed on 8107
LLM_ORDER=gemini,ollama
GATEWAY_V7_PORT=8107
LLM_GATEWAY_V7_URL=http://localhost:8107

# Optional — without this, web_search falls back to DuckDuckGo
# TAVILY_API_KEY=
