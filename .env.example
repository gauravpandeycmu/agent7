# Default assignment configuration — local chat and local embeddings
AGENT_CHAT_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
EMBED_OLLAMA_MODEL=nomic-embed-text
EMBED_ORDER=ollama

# Gateway V7 (professor ZIP) — chat + embed on 8107
LLM_ORDER=ollama
GATEWAY_V7_PORT=8107
LLM_GATEWAY_V7_URL=http://localhost:8107

# Optional — web_search has non-key fallbacks when this is unset
# TAVILY_API_KEY=

# Optional cloud chat provider; unused by the default local configuration
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
